// WinLoss — Bankroll Tracker
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  currency      String    @default("PEN")
  timezone      String    @default("America/Lima")
  autoSettleMode AutoSettleMode @default(SUGGEST)
  // Privacidad de la comunidad: solo agregados si el usuario lo permite.
  shareAnonymousStats Boolean @default(true)
  favoriteTeams String[] @default([])
  favoriteCompetitions String[] @default([])
  // Tasa manual USD → PEN para reportes de deudas (unidades PEN por 1 USD).
  usdToPenRate Decimal? @db.Decimal(12, 6)
  // Umbral de alerta de deuda sobre capital propio.
  debtAlertThresholdPct Decimal @default(30) @db.Decimal(5, 2)
  showDebts     Boolean   @default(true)
  // Juego responsable: límite semanal de stake (PEN) y autoexclusión.
  weeklyStakeLimit    Decimal?  @db.Decimal(12, 2)
  selfExclusionUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  bankrolls  Bankroll[]
  bookmakers Bookmaker[]
  bets       Bet[]
  debts      Debt[]
  exchangeRates ExchangeRate[]
  bankrollTransactions BankrollTransaction[]
}

model ExchangeRate {
  id          String   @id @default(cuid())
  userId      String
  // Banco o casa de cambio de donde sale la tasa.
  label       String
  // Unidades PEN por 1 USD: compra y venta del banco.
  buyRate     Decimal  @db.Decimal(12, 6)
  sellRate    Decimal  @db.Decimal(12, 6)
  effectiveAt DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Dominio: bankroll, casas de apuestas y apuestas
// ---------------------------------------------------------------------------

model Bankroll {
  id            String   @id @default(cuid())
  userId        String
  name          String
  currency      String   @default("PEN")
  initialAmount Decimal  @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets Bet[]
  debts Debt[]
  transactions BankrollTransaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Bookmaker {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets Bet[]

  @@unique([userId, name])
  @@index([userId])
}

model Bet {
  id          String    @id @default(cuid())
  userId      String
  bankrollId  String
  bookmakerId String?
  // Identificador del boleto en la casa de apuestas (opcional).
  externalId  String?
  // @deprecated: la información del evento vive ahora en BetLeg/LegSelection.
  sport       String
  // @deprecated: usar BetLeg.competition.
  competition String?
  // @deprecated: usar BetLeg.eventName.
  eventName   String
  // @deprecated: usar LegSelection.market.
  market      String
  // @deprecated: usar LegSelection.selection.
  selection   String
  // Cuota total del boleto. Puede sobrescribirse manualmente (boosts/redondeos).
  odds        Decimal   @db.Decimal(10, 3)
  stake       Decimal   @db.Decimal(12, 2)
  status      BetStatus @default(PENDING)
  // Derivado de la cantidad de legs para filtrar rápido.
  betType     BetType   @default(SINGLE)
  isFreeBet   Boolean   @default(false)
  // % de ganancia aumentada de la casa (ej. 5 = +5% sobre el retorno).
  oddsBoostPct Decimal? @db.Decimal(5, 2)
  placedAt    DateTime  @default(now())
  settledAt   DateTime?
  // Importe total devuelto por la casa (stake incluido, salvo free bets).
  payout      Decimal?  @db.Decimal(12, 2)
  // Beneficio neto. Negativo si la apuesta se pierde.
  profit      Decimal?  @db.Decimal(12, 2)
  // @deprecated: el CLV se calcula por leg en BetLeg.closingOdds.
  closingOdds Decimal?  @db.Decimal(8, 3)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankroll  Bankroll   @relation(fields: [bankrollId], references: [id], onDelete: Restrict)
  bookmaker Bookmaker? @relation(fields: [bookmakerId], references: [id], onDelete: SetNull)
  legs      BetLeg[]

  @@unique([userId, externalId])
  @@index([userId, placedAt])
  @@index([bankrollId, status])
  @@index([bookmakerId])
}

model BetLeg {
  id          String    @id @default(cuid())
  betId       String
  position    Int
  sport       String
  competition String?
  eventName   String
  eventDate   DateTime?
  // Un Bet Builder combina 2+ selecciones del mismo evento con una cuota manual.
  isBuilder   Boolean   @default(false)
  odds        Decimal   @db.Decimal(8, 3)
  closingOdds Decimal?  @db.Decimal(8, 3)
  status      LegStatus @default(PENDING)

  // Evento de proveedor externo (opcional, para auto-liquidación).
  externalProvider String?
  externalEventId  String?
  homeTeam         String?
  awayTeam         String?
  scoreHome        Int?
  scoreAway        Int?
  autoSettled      Boolean @default(false)

  bet        Bet            @relation(fields: [betId], references: [id], onDelete: Cascade)
  selections LegSelection[]

  @@index([betId])
  @@index([status, eventDate])
  @@index([externalProvider, externalEventId])
}

model LegSelection {
  id        String @id @default(cuid())
  legId     String
  position  Int
  market    String
  selection String

  // Mercado estructurado para auto-liquidación.
  marketKey LegMarketKey @default(CUSTOM)
  line      Decimal?     @db.Decimal(6, 2)
  pick      String?
  /** Sujeto del mercado: HOME, AWAY o MATCH. */
  subject   String?

  leg BetLeg @relation(fields: [legId], references: [id], onDelete: Cascade)

  @@index([legId])
}

// ---------------------------------------------------------------------------
// Deudas y libro de movimientos del bankroll
// ---------------------------------------------------------------------------

model Debt {
  id        String   @id @default(cuid())
  userId    String
  bankrollId String
  lenderName String
  principal Decimal  @db.Decimal(14, 2)
  currency  DebtCurrency
  borrowedAt DateTime
  dueDate   DateTime?
  // Interés simple mensual en porcentaje (ej. 2.5 = 2.5% mensual).
  interestRateMonthly Decimal? @db.Decimal(12, 6)
  // Tasa aplicada al registrar la deuda (PEN por 1 unidad de la moneda).
  exchangeRate Decimal? @db.Decimal(12, 6)
  // "BUY" (compra del banco) o "SELL" (venta del banco).
  rateKind  String?
  rateLabel String?
  status    DebtStatus @default(OPEN)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankroll Bankroll  @relation(fields: [bankrollId], references: [id], onDelete: Restrict)
  payments DebtPayment[]
  transactions BankrollTransaction[]

  @@index([userId, status])
  @@index([bankrollId])
  @@index([userId, dueDate])
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime
  source    DebtPaymentSource
  exchangeRate Decimal? @db.Decimal(12, 6)
  rateKind  String?
  rateLabel String?
  note      String?
  // Un pago anulado conserva el registro y su fecha de anulación.
  voidedAt  DateTime?
  createdAt DateTime @default(now())

  debt        Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction BankrollTransaction?

  @@index([debtId, paidAt])
}

model BankrollTransaction {
  id          String   @id @default(cuid())
  userId      String
  bankrollId  String
  type        BankrollTransactionType
  // Importe original, siempre positivo. El signo vive en el tipo.
  amount      Decimal  @db.Decimal(14, 2)
  currency    DebtCurrency
  // Unidades de moneda del bankroll por 1 unidad de `currency`.
  exchangeRate Decimal? @db.Decimal(12, 6)
  // Importe convertido y firmado: positivo entra, negativo sale.
  amountInBankrollCurrency Decimal @db.Decimal(14, 2)
  occurredAt  DateTime
  note        String?
  debtId      String?
  debtPaymentId String? @unique
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankroll  Bankroll  @relation(fields: [bankrollId], references: [id], onDelete: Restrict)
  debt      Debt?     @relation(fields: [debtId], references: [id], onDelete: SetNull)
  debtPayment DebtPayment? @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([bankrollId, occurredAt])
  @@index([debtId])
}

model Team {
  id             String   @id @default(cuid())
  canonicalName  String
  normalizedName String   @unique
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  aliases       TeamAlias[]
  homeMatches   HistoricalMatch[] @relation("HomeTeam")
  awayMatches   HistoricalMatch[] @relation("AwayTeam")
  ratings       TeamRating[]
  homeFixtures  UpcomingFixture[] @relation("FixtureHome")
  awayFixtures  UpcomingFixture[] @relation("FixtureAway")
  homeAnalyses  MatchAnalysis[] @relation("AnalysisHome")
  awayAnalyses  MatchAnalysis[] @relation("AnalysisAway")

  @@index([canonicalName])
}

model TeamAlias {
  id         String @id @default(cuid())
  teamId     String
  alias      String
  normalized String @unique

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model HistoricalMatch {
  id              String   @id @default(cuid())
  source          String
  competition     String
  competitionCode String?
  season          String
  seasonStart     Int
  // Fecha del partido a mediodía UTC para que la clave sea estable.
  playedAt        DateTime
  homeTeamId      String
  awayTeamId      String
  homeGoals       Int
  awayGoals       Int
  result          String?
  odds            Json?
  stats           Json?
  // Resultado provisional de API; el CSV oficial lo reemplaza.
  provisional     Boolean  @default(false)
  // Clave común CSV/API: competición + fecha + equipos normalizados.
  dedupeKey       String?  @unique
  importedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)

  @@unique([competition, season, playedAt, homeTeamId, awayTeamId])
  @@index([competition, playedAt])
  @@index([homeTeamId, playedAt])
  @@index([awayTeamId, playedAt])
}

model TeamRating {
  id                 String   @id @default(cuid())
  competition        String
  competitionCode    String?
  teamId             String
  asOf               DateTime
  attack             Decimal  @db.Decimal(12, 6)
  defense            Decimal  @db.Decimal(12, 6)
  homeAdvantage      Decimal? @db.Decimal(12, 6)
  leagueAvgHomeGoals Decimal? @db.Decimal(12, 6)
  leagueAvgAwayGoals Decimal? @db.Decimal(12, 6)
  sampleMatches      Int
  params             Json?
  createdAt          DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([competition, teamId, asOf])
  @@index([competition, asOf])
}

model MatchAnalysis {
  id              String           @id @default(cuid())
  source          String
  externalEventId String
  competition     String
  competitionCode String?
  homeTeamId      String?
  awayTeamId      String?
  homeName        String
  awayName        String
  kickoff         DateTime
  probabilities   Json
  confidence      AnalysisConfidence
  metadata        Json?
  generatedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  homeTeam Team? @relation("AnalysisHome", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam Team? @relation("AnalysisAway", fields: [awayTeamId], references: [id], onDelete: SetNull)

  @@unique([source, externalEventId])
  @@index([kickoff])
  @@index([competition, kickoff])
}

model ModelEvaluation {
  id              String   @id @default(cuid())
  competition     String
  model           String
  asOf            DateTime
  sample          Int
  brier           Decimal? @db.Decimal(12, 6)
  logLoss         Decimal? @db.Decimal(12, 6)
  baselineBrier   Decimal? @db.Decimal(12, 6)
  baselineLogLoss Decimal? @db.Decimal(12, 6)
  // Mercado pre-cierre (AvgH/D/A) sobre el subconjunto que lo tiene.
  preSample       Int?
  baselinePreBrier   Decimal? @db.Decimal(12, 6)
  baselinePreLogLoss Decimal? @db.Decimal(12, 6)
  // Línea base ingenua: frecuencias históricas local/empate/visitante.
  naiveBrier      Decimal? @db.Decimal(12, 6)
  naiveLogLoss    Decimal? @db.Decimal(12, 6)
  // Recalibración walk-forward por temperatura.
  temperature       Decimal? @db.Decimal(8, 4)
  calibrationSample Int?
  calibratedBrier   Decimal? @db.Decimal(12, 6)
  calibratedLogLoss Decimal? @db.Decimal(12, 6)
  // Mezcla modelo/mercado validada temporalmente.
  blendWeight     Decimal? @db.Decimal(6, 4)
  blendSample     Int?
  blendBrier      Decimal? @db.Decimal(12, 6)
  blendLogLoss    Decimal? @db.Decimal(12, 6)
  calibration     Json?
  validation      Json?
  params          Json?
  createdAt       DateTime @default(now())

  @@unique([competition, model, asOf])
}

model FixtureBatch {
  id         String   @id @default(cuid())
  source     String
  sourceFile String
  capturedAt DateTime
  importedAt DateTime @default(now())
  rowCount   Int
  metadata   Json?

  fixtures UpcomingFixture[]

  @@index([source, capturedAt])
}

model UpcomingFixture {
  id             String   @id @default(cuid())
  batchId        String
  source         String
  sourceKey      String   @unique
  competition    String
  competitionCode String?
  kickoff        DateTime
  homeTeamId     String?
  awayTeamId     String?
  homeName       String
  awayName       String
  odds           Json?
  oddsCapturedAt DateTime?
  createdAt      DateTime @default(now())

  batch    FixtureBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  homeTeam Team?        @relation("FixtureHome", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam Team?        @relation("FixtureAway", fields: [awayTeamId], references: [id], onDelete: SetNull)

  @@index([kickoff])
  @@index([competition, kickoff])
}

enum AnalysisConfidence {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

enum DebtCurrency {
  PEN
  USD
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
}

enum DebtPaymentSource {
  FROM_BANKROLL
  EXTERNAL
}

enum BankrollTransactionType {
  DEPOSIT
  WITHDRAWAL
  LOAN_IN
  LOAN_REPAYMENT
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
  HALF_WON
  HALF_LOST
  CASHOUT
}

enum BetType {
  SINGLE
  COMBINED
}

enum LegStatus {
  PENDING
  WON
  LOST
  VOID
  HALF_WON
  HALF_LOST
}

enum LegMarketKey {
  CUSTOM
  MATCH_RESULT
  DOUBLE_CHANCE
  DRAW_NO_BET
  TOTAL_GOALS
  BTTS
  ASIAN_HANDICAP
  TEAM_TOTAL_GOALS
  ODD_EVEN
  WIN_TO_NIL
  EXACT_TOTAL_GOALS
  TOTAL_CORNERS
  TOTAL_CARDS
  GENERIC_LINE
}

enum AutoSettleMode {
  SUGGEST
  AUTO
}

model AnalysisImportFile {
  path        String   @id
  kind        String
  size        Int
  mtime       DateTime
  hash        String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, processedAt])
}

model AnalysisRefreshLock {
  key       String   @id
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model AnalysisRefreshRun {
  id         String   @id @default(cuid())
  trigger    String   @default("cron")
  status     String
  startedAt  DateTime
  finishedAt DateTime?
  durationMs Int?
  steps      Json?
  error      String?
  createdAt  DateTime @default(now())

  @@index([startedAt])
}

model ResultDiscrepancy {
  id          String   @id @default(cuid())
  dedupeKey   String
  competition String
  playedAt    DateTime
  homeTeamId  String
  awayTeamId  String
  csvHomeGoals Int
  csvAwayGoals Int
  apiHomeGoals Int
  apiAwayGoals Int
  apiSource    String
  resolvedBy   String   @default("csv")
  createdAt    DateTime @default(now())

  @@index([dedupeKey])
  @@index([competition, playedAt])
}

model AnalysisSnapshot {
  id String @id @default(cuid())

  matchKey        String
  externalEventId String
  competition     String
  competitionCode String?
  kickoff         DateTime
  snapshotAt      DateTime
  homeName        String
  awayName        String
  homeTeamId      String?
  awayTeamId      String?

  confidence        AnalysisConfidence
  finalSource       String
  marketProbability Json?
  modelProbability  Json?
  finalProbability  Json?
  communityProbability Json?
  communitySample      Int?
  communityAvailable   Boolean?
  topScores            Json?
  markets              Json?
  ratingsVersion    String?
  ratingsParams     Json?
  marketCapturedAt  DateTime?
  marketFresh       Boolean?

  evaluatedAt  DateTime?
  supersededAt DateTime?
  result       String?
  outcome      Int?
  homeGoals    Int?
  awayGoals    Int?
  resultSource String?
  marketBrier   Decimal? @db.Decimal(12, 6)
  marketLogLoss Decimal? @db.Decimal(12, 6)
  modelBrier    Decimal? @db.Decimal(12, 6)
  modelLogLoss  Decimal? @db.Decimal(12, 6)

  // Predicción del retador en sombra; no se muestra en /analysis.
  challengerProbability Json?
  challengerVersionId   String?
  challengerBrier       Decimal? @db.Decimal(12, 6)
  challengerLogLoss     Decimal? @db.Decimal(12, 6)

  createdAt DateTime @default(now())

  @@unique([matchKey, snapshotAt])
  @@index([kickoff])
  @@index([evaluatedAt])
  @@index([competition, evaluatedAt])
  @@index([matchKey, kickoff])
  @@index([challengerVersionId])
}

enum ModelVersionState {
  CHAMPION
  CHALLENGER
  RETIRED
}

model ModelVersion {
  id String @id @default(cuid())

  name   String
  state  ModelVersionState @default(CHALLENGER)
  quick  Boolean           @default(false)
  params Json
  metrics Json?
  notes  String?

  createdAt        DateTime  @default(now())
  promotedAt       DateTime?
  retiredAt        DateTime?
  previousVersionId String?

  @@index([state, createdAt])
}

model MatchReviewCache {
  id String @id @default(cuid())

  historicalMatchId String
  modelVersionId    String
  probabilities     Json
  ratingsAsOf       DateTime
  calculatedAt      DateTime @default(now())

  @@unique([historicalMatchId, modelVersionId])
  @@index([modelVersionId, calculatedAt])
}

model RatingAsOfCache {
  id String @id @default(cuid())

  competitionCode String
  weekStart       DateTime
  modelVersionId  String
  ratings         Json
  matchesUsed     Int
  calculatedAt    DateTime @default(now())

  @@unique([competitionCode, weekStart, modelVersionId])
  @@index([modelVersionId, calculatedAt])
}

model ParlayOddsSnapshot {
  id String @id @default(cuid())

  sportKey String
  eventId String
  eventName String
  market String @default("h2h")
  outcome String
  bookmaker String
  price Decimal @db.Decimal(8, 3)
  capturedAt DateTime @default(now())

  @@index([eventId, market, capturedAt])
  @@index([capturedAt])
}
