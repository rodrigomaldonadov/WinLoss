# Copia este archivo a .env y rellena los valores.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/winloss?schema=public"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# URL pública de la app (enlaces de recuperación de contraseña).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email transaccional (opcional). Sin clave, el enlace se registra en el log.
RESEND_API_KEY=""
RESEND_FROM="WinLoss <onboarding@resend.dev>"

# OCR real (opcional). Sin claves se usa el boleto de ejemplo.
