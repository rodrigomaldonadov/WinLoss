# Copia este archivo a .env y rellena los valores.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/winloss?schema=public"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# URL pública de la app (enlaces de recuperación de contraseña).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email transaccional (opcional). Sin clave, el enlace se registra en el log.
RESEND_API_KEY=""
RESEND_FROM="WinLoss <onboarding@resend.dev>"

# OCR real (opcional). Sin claves se usa el boleto de ejemplo.
# OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4o-mini"
# GEMINI_API_KEY=""
# GEMINI_VISION_MODEL="gemini-2.0-flash"

# Proveedores deportivos (auto-liquidación).
# football-data.org: plan free = 12 competiciones; NO incluye Liga 1 ni Libertadores.
FOOTBALL_DATA_API_KEY=""
# TheSportsDB: cubre Liga 1 y Libertadores. "123" es la clave de test pública.
THESPORTSDB_API_KEY="123"
# auto | football-data | thesportsdb | fake
SPORTS_API_PROVIDER="auto"

# Cron de auto-liquidación: GET /api/cron/settle con Authorization: Bearer <secreto>.
CRON_SECRET=""

# Job de /analysis: GET /api/cron/analysis-refresh con el mismo CRON_SECRET.
# Volumen persistente con los CSV descargados manualmente desde football-data.co.uk.
ANALYSIS_DATA_DIR="data-football"
ANALYSIS_WINDOW_DAYS="14"
# Los ratings se reajustan como máximo una vez cada N días.
ANALYSIS_RATING_MAX_AGE_DAYS="7"
# Límite del job completo en milisegundos (15 min por defecto en el host).
ANALYSIS_REFRESH_TIMEOUT_MS="840000"
